# Managed by Ansible. Read by scripts/verify.sh so it checks what was actually configured.
ADMIN_USER={{ admin_user | quote }}
SSH_PORT={{ ssh_port }}
ENABLE_DOCKER={{ 1 if enable_docker | bool else 0 }}
ENABLE_STACK={{ 1 if enable_docker | bool and enable_stack | bool else 0 }}
STACK_DOMAIN={{ stack_domain | quote }}
STACK_DEMO={{ 1 if stack_demo_app | bool else 0 }}
STACK_DIR={{ stack_dir | quote }}
ENABLE_BACKUPS={{ 1 if enable_backups | bool else 0 }}
ENABLE_HEALTHCHECK={{ 1 if enable_healthcheck | bool else 0 }}
AUTO_UPDATES={{ 1 if auto_updates | bool else 0 }}
