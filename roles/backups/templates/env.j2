# Managed by Ansible
RESTIC_REPOSITORY={{ backup_repo }}
RESTIC_PASSWORD_FILE=/etc/restic/password
BACKUP_PATHS="{{ backup_paths | join(' ') }}"
KEEP_DAILY={{ backup_keep_daily }}
KEEP_WEEKLY={{ backup_keep_weekly }}
KEEP_MONTHLY={{ backup_keep_monthly }}
CHECK_SUBSET={{ backup_check_subset }}
{% for key, value in backup_env.items() %}
{{ key }}={{ value | quote }}
{% endfor %}
